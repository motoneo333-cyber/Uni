# Copia este archivo como .env (para desarrollo local) y completá los valores reales.
# En Vercel, configurá estas mismas variables en Project Settings > Environment Variables.
# El archivo .env real NUNCA se commitea (ver .gitignore).

# Cadena de conexión a Postgres (Neon, Vercel Postgres o Supabase).
DATABASE_URL="postgresql://usuario:password@host:5432/basededatos?sslmode=require"

# Contraseña para entrar a la app (elegí una vos).
APP_PASSWORD="cambiame"

# Secreto para firmar la cookie de sesión (cadena larga y aleatoria).
APP_SECRET="cambiame-por-una-cadena-larga-y-aleatoria"
